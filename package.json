{
  "name": "dsh-chatgpt-plan",
  "version": "0.1.6-daybreak",
  "description": "Use your ChatGPT plan in DeepSeek Harness with independent Sign in with ChatGPT authorization",
  "type": "module",
  "main": "index.mjs",
  "icon": "./assets/icon.webp",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "adapter.mjs",
    "inference-options.mjs",
    "oauth.mjs",
    "network.mjs",
    "storage.mjs",
    "management.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "assets/icon.webp"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || >=0.2.1-rc.3 <0.2.2-0",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2 || >=0.2.1-rc.3 <0.2.2-0",
    "@earendil-works/pi-ai": "0.87.1 || ~1.1.0"
  },
  "dependencies": {
    "undici": "^7.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillQvQ/dsh-chatgpt-plan.git"
  },
  "homepage": "https://github.com/WillQvQ/dsh-chatgpt-plan#readme",
  "bugs": {
    "url": "https://github.com/WillQvQ/dsh-chatgpt-plan/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
